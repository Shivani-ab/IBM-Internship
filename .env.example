# Copy this file to ".env" (remove the ".example" part) and put your
# real Google Gemini API key below. Never share this file or commit it
# to version control.
# Get a key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_api_key_here

# Optional settings (safe to leave as-is for a beginner setup):
# GEMINI_MODEL=gemini-2.5-flash
# DOCUMENTS_DIR=backend/data/documents
# CHROMA_DB_DIR=chroma_db
# CHROMA_COLLECTION_NAME=college_documents
# RAG_TOP_K=4
# MEMORY_MAX_TURNS=10
